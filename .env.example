# ============================================================
# futureFlow 根目录环境变量
# ============================================================
FUTUREFLOW_ENV_SCHEMA_VERSION=2

# 首次启动时 start.bat 会自动将本文件复制为 .env
# 三层 API Key 体系说明(见 README 「API Key 体系」章节):
#   1. 平台 API Key(ff-xxx): 用户在个人中心创建,数据库哈希存储
#   2. LLM API Key(sk-xxx):  服务端读取并安全同步到 Dify Provider
#   3. Dify API Key(app-xxx): 网关内置,自动从 DIFY_API_KEY 读取
# ============================================================

# PostgreSQL(网关数据库)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=futureflow
POSTGRES_USER=futureflow
POSTGRES_PASSWORD=replace-with-a-random-postgres-password-at-least-32-characters

# ─────────────────────────────────────────────────────────────
# LLM API Key(服务端安全同步到 Dify Provider,用户无感)
# 画布 LLM 节点只暴露模型名/温度/提示词,API Key 不进入画布或运行结果
# 获取: https://platform.deepseek.com/api_keys
# ─────────────────────────────────────────────────────────────
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_HOST=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-chat
# 浏览器试运行调用网关 LLM 代理所需的票据有效期（秒）。票据只发给登录用户，
# 且只能用于 /llm/chat/completions；调小更安全，但长流程可能需要续期。
# 取值范围 60~3600，留空或非法值按 600 处理。
LLM_PROXY_TICKET_TTL_SECONDS=600
# 保存 Dify 管理员授权时，若对应 Provider 尚未配置，自动保存并验证上述凭据。
# 验证会调用一次模型接口，可能产生极少量供应商用量；已有有效 Provider 时不会重复调用。
DIFY_SYNC_LLM_PROVIDER=true
# 仅在明确轮换 LLM_API_KEY 时临时设为 true；会覆盖并重新验证现有 Provider。
DIFY_FORCE_LLM_PROVIDER_SYNC=false

# ─────────────────────────────────────────────────────────────
# Dify API Key(网关调用 Dify Service API,自动内置)
# 在 Dify 控制台(http://localhost:8080)创建工作流应用后,
# 于「访问 API」页面复制 app- 前缀密钥填入下方
# 未配置时已发布工作流不能运行；草稿仍可使用浏览器“试运行”调试
# ─────────────────────────────────────────────────────────────
DIFY_API_BASE=http://localhost:5001/v1
DIFY_API_KEY=

# Dify 本地控制面只绑定 127.0.0.1。管理员密码和 Dify SECRET_KEY 会由
# env:init 在首次启动时生成；部署环境请通过秘密管理系统注入并长期保留。
DIFY_API_PORT=5001
DIFY_WEB_PORT=8080
DIFY_DB_PASSWORD=replace-with-a-random-dify-database-password-at-least-32-characters
DIFY_ADMIN_EMAIL=admin@futureflow.local
DIFY_ADMIN_PASSWORD=replace-with-a-random-admin-password-at-least-32-characters
DIFY_SECRET_KEY=replace-with-a-random-dify-secret-at-least-32-characters

# Managed Dify mode: quickstart automatically saves the local Console session
# encrypted in PostgreSQL. Each published workflow version then gets its own
# application, imported DSL, and Service API key.
# Credentials are encrypted in PostgreSQL; never paste the generated app-* key
# back into this file. Use a unique random secret of at least 32 characters.
# The local quickstart creates a random value when it creates .env. In a
# deployed environment set and retain your own secret; changing it makes
# existing encrypted Dify credentials unreadable.
DIFY_KEY_ENCRYPTION_SECRET=replace-with-a-random-secret-at-least-32-characters

# 图片/视频供应商 API Key、MCP Bearer 令牌、草稿沙箱凭据都按租户保存，并使用
# AES-256-GCM 加密（AAD 绑定属主，密文不可跨记录搬移）。
# env:init 会生成本机随机值。加密恒用本变量；DIFY_KEY_ENCRYPTION_SECRET 只作为
# **历史数据的兼容密钥**参与解密尝试——所以随时补上本变量都不会让已有数据不可读，
# 也不需要先做数据迁移（旧密钥可择机停用）。
MEDIA_CREDENTIAL_ENCRYPTION_SECRET=
MEDIA_ASSET_ROOT=.futureflow-media
MEDIA_PROVIDER_TIMEOUT_MS=120000
MEDIA_PROVIDER_JSON_MAX_BYTES=41943040
MEDIA_DOWNLOAD_TIMEOUT_MS=120000
MEDIA_IMAGE_MAX_BYTES=26214400
MEDIA_VIDEO_MAX_BYTES=262144000

# 发布态的 Dify 容器回调本机媒体网关时使用。开发环境网关若使用 3201 端口，
# 请同时设置三个值为 host.docker.internal / 3201；生产环境请改为网关的
# 专用内网地址，并保持 SSRF 代理只放行该精确主机和端口。
# SSRF 代理容器里 host.docker.internal 的映射值。
# Linux 原生 Docker 留空（compose 默认 host-gateway）；
# Docker Desktop(Windows/WSL2) 必须显式写成 192.168.65.254，
# 否则 host-gateway 会落成 WSL2 的 IPv6 地址，导致 HTTP/MCP/媒体节点在云端执行时连不上网关。
DIFY_SSRF_HOST_GATEWAY=
DIFY_MEDIA_GATEWAY_URL=http://host.docker.internal:3001
DIFY_MEDIA_GATEWAY_HOST=host.docker.internal
DIFY_MEDIA_GATEWAY_PORT=3001

# Dify 控制台(Console API,用于在发布时自动创建独立应用并导入 DSL,可选)
# 在 Dify 账号设置 -> API 密钥 中生成 Console Token
# 兼容既有单个 Dify 应用的可选项；受控模式无需填写，发布时会自动创建专属应用
# 本地一键启动默认使用上面的随机管理员凭据登录并加密保存授权；设为 false 可显式关闭。
DIFY_AUTO_BOOTSTRAP=true
DIFY_MANAGED_BRIDGE=true
DIFY_CONSOLE_BASE=http://localhost:5001/console/api
DIFY_CONSOLE_TOKEN=
DIFY_APP_ID=

# Dify 0.15.3 Code / HTTP 节点基础设施
# Sandbox Key 只在 Dify API/Worker 与隔离容器之间使用。env:init 会为本地
# 环境自动生成随机值；生产环境必须使用独立强密钥。
DIFY_SANDBOX_API_KEY=replace-with-a-random-sandbox-key-at-least-32-characters
DIFY_SANDBOX_WORKER_TIMEOUT=15
# Dify 0.15.3 的代码执行请求要求启用 Sandbox 网络。Sandbox 只连接隔离网络，
# HTTP(S) 出网继续经过带 ACL 的 SSRF Proxy；用户代码不应直接保存网络凭据。
DIFY_SANDBOX_ENABLE_NETWORK=true
DIFY_CODE_EXECUTION_CONNECT_TIMEOUT=10
DIFY_CODE_EXECUTION_READ_TIMEOUT=60
DIFY_CODE_EXECUTION_WRITE_TIMEOUT=10
DIFY_SSRF_HTTP_PORT=3128
# 可选：部分受控桌面环境把公网域名映射到 198.18/15。仅填写可信 API 域名，
# 多个域名以空格分隔；留空/默认 .invalid 时不会绕过该网段的拒绝规则。
DIFY_SSRF_SYNTHETIC_DNS_ALLOWED_DOMAINS=.invalid
# Dify HTTP 节点响应上限：二进制 10 MiB、文本 1 MiB。
DIFY_HTTP_MAX_BINARY_SIZE=10485760
DIFY_HTTP_MAX_TEXT_SIZE=1048576

# 网关默认仅监听本机。如需从其他主机访问，显式修改 GATEWAY_HOST，
# 同时配置 CORS、防火墙和反向代理访问控制。
GATEWAY_HOST=127.0.0.1
# 「Python 执行」节点在浏览器试运行时由网关调用本机 Python 完成，等价于
# 允许登录用户在网关宿主执行任意代码。默认仅在 GATEWAY_HOST 为回环地址时
# 开放；对外监听（含内网地址）时必须显式设为 true 才会启用，并应自行评估
# 风险——此时该端点**只对管理员开放**。设为 false 可彻底关闭（Python 节点
# 不可试运行）。
PYTHON_EXEC_ENABLED=
GATEWAY_PORT=3001
# 前端 dev 端口（rsbuild）；与宿主机其他服务冲突时修改
FRONTEND_PORT=3000
PUBLIC_GATEWAY_URL=http://localhost:3001
GATEWAY_JWT_SECRET=replace-with-a-random-gateway-jwt-secret-at-least-32-characters

# 本地一键启动默认创建管理员；设为 false 可显式关闭。默认登录密码为
# futureFlow@（可通过本机 .env 的 GATEWAY_BOOTSTRAP_ADMIN_PASSWORD 覆盖），
# 密码不会写入应用日志，已有管理员也不会被覆盖。
GATEWAY_BOOTSTRAP_ADMIN_ENABLED=true
GATEWAY_BOOTSTRAP_ADMIN_USERNAME=admin
GATEWAY_BOOTSTRAP_ADMIN_EMAIL=admin@futureflow.local
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD=futureFlow@

# 登录暴力破解防护（按 IP+账号）。15 分钟窗口内失败超过上限后锁定。
# 本地开发误触发锁定时：重启网关立即清除计数，或放宽以下阈值
# LOGIN_RATE_LIMIT_MAX_FAILURES=8
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# LOGIN_RATE_LIMIT_BLOCK_MINUTES=15

# 运行保护与定时触发器（生产环境会校验为正整数）
WORKFLOW_MAX_CONCURRENT_PER_USER=3
WORKFLOW_MAX_RUNS_PER_MINUTE=30
WORKFLOW_SCHEDULE_TICK_SECONDS=30
# 定时触发器单次执行失败后的重试策略：
#   RUN_MAX_ATTEMPTS 含首次在内的总尝试次数（上限 10），默认 2 = 首次 + 1 次重试
#   RETRY_BASE_MS    首次重试的退避时长，后续按 2 的幂增长（单次封顶 60s）
#   FAILURE_ALERT_THRESHOLD 连续失败达到该次数时输出 error 级日志，提示人工介入
# 登录用户调用本机执行类接口的频率上限（每分钟、按用户）。这两个端点分别会
# 真实消耗平台 LLM 额度、在网关宿主起 Python 进程，票据只确认身份、不限额度。
# 留空或非法值按默认（LLM 30 / Python 20）。多实例部署时为「每实例」限流。
LLM_PROXY_MAX_PER_MINUTE=30
# 单次调用的成本上限：请求体会原样转发给上游，而上游用的是平台自己的 Key，
# 限流只管「一分钟几次」，这里管「一次最多花多少」。
#   MAX_TOKENS       单次 max_tokens 的收敛上限（超了压到这里，缺省 4096）
#   MAX_COMPLETIONS  单次 n（返回几条）的收敛上限（超了压到这里，缺省 1）
# 其余字段（temperature 等）原样透传，不做重塑。
LLM_PROXY_MAX_TOKENS=4096
LLM_PROXY_MAX_COMPLETIONS=1
PYTHON_EXEC_MAX_PER_MINUTE=20
WORKFLOW_TRIGGER_RUN_MAX_ATTEMPTS=2
WORKFLOW_TRIGGER_RETRY_BASE_MS=2000
WORKFLOW_TRIGGER_FAILURE_ALERT_THRESHOLD=3
# 连续失败到该次数后**自动暂停**触发器（改状态为 paused，可在界面手动恢复）。
# 一个注定失败的触发器会按周期永远跑下去，既占用有限的并发名额，又持续消耗
# Dify/LLM 用量。设为 0 表示关闭自动暂停（一直重试到修好为止）。
WORKFLOW_TRIGGER_AUTO_PAUSE_FAILURES=20
# 残留运行对账：进程崩溃会在 workflow_runs 留下永远 running 的记录，既占用
# frozenBalance 又占用并发额度，累计到上限后用户无法再启动工作流。以下两项控制
# 回收阈值与扫描间隔（阈值须远大于任何正常执行耗时）。
WORKFLOW_STALE_RUN_MINUTES=30
WORKFLOW_STALE_RUN_SWEEP_SECONDS=300
# 媒体任务对账：进程中断会让任务永远停在 creating/queued/processing，界面一直
# 「生成中」且同一幂等键无法重试。超过阈值仍非终态的会被先尝试补记成功、
# 仍不成立则标记为失败（job_stale_timeout），用户换新幂等键即可重试。
MEDIA_STALE_JOB_MINUTES=30
MEDIA_STALE_JOB_SWEEP_SECONDS=300
LLM_REQUEST_TIMEOUT_MS=120000

# 前端 CORS 白名单(逗号分隔)
CORS_ORIGIN=http://localhost:3000
