# ============================================================
# futureFlow 根目录环境变量
# ============================================================
# 首次启动时 start.bat 会自动将本文件复制为 .env
# 三层 API Key 体系说明(见 README 「API Key 体系」章节):
#   1. 平台 API Key(ff-xxx): 用户在个人中心创建,数据库哈希存储
#   2. LLM API Key(sk-xxx):  网关内置,自动从 LLM_API_KEY 读取
#   3. Dify API Key(app-xxx): 网关内置,自动从 DIFY_API_KEY 读取
# ============================================================

# PostgreSQL(网关数据库)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=futureflow
POSTGRES_USER=futureflow
POSTGRES_PASSWORD=futureflow123

# ─────────────────────────────────────────────────────────────
# LLM API Key(网关调用 DeepSeek/OpenAI,自动内置,用户无感)
# 画布 LLM 节点只暴露模型名/温度/提示词,API Key 完全由网关管理
# 获取: https://platform.deepseek.com/api_keys
# ─────────────────────────────────────────────────────────────
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_HOST=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────────
# Dify API Key(网关调用 Dify Service API,自动内置)
# 在 Dify 控制台(http://localhost:8080)创建工作流应用后,
# 于「访问 API」页面复制 app- 前缀密钥填入下方
# 未配置时网关自动降级为直接 LLM 模式(使用上面的 LLM_API_KEY)
# ─────────────────────────────────────────────────────────────
DIFY_API_BASE=http://localhost:5001/v1
DIFY_API_KEY=

# Recommended managed Dify bridge mode: after one admin authorization, the
# platform creates/reuses the bridge app and generates its Service API key.
# Credentials are encrypted in PostgreSQL; never paste the generated app-* key
# back into this file. Use a unique random secret of at least 32 characters.
# The local quickstart creates a random value when it creates .env. In a
# deployed environment set and retain your own secret; changing it makes
# existing encrypted Dify credentials unreadable.
DIFY_KEY_ENCRYPTION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Dify 控制台(Console API,用于在发布时自动创建独立应用并导入 DSL,可选)
# 在 Dify 账号设置 -> API 密钥 中生成 Console Token
# 兼容既有单个 Dify 应用的可选项；受控模式无需填写，发布时会自动创建专属应用
# 默认不在启动时读取或使用 Console Token。仅在受控部署中明确设为 true，才允许启动时自动保存授权。
DIFY_AUTO_BOOTSTRAP=false
DIFY_CONSOLE_BASE=http://localhost:5001/console/api
DIFY_CONSOLE_TOKEN=
DIFY_APP_ID=

# 网关
GATEWAY_PORT=3001
PUBLIC_GATEWAY_URL=http://localhost:3001
GATEWAY_JWT_SECRET=change-me-in-production

# 运行保护与定时触发器（生产环境会校验为正整数）
WORKFLOW_MAX_CONCURRENT_PER_USER=3
WORKFLOW_MAX_RUNS_PER_MINUTE=30
WORKFLOW_SCHEDULE_TICK_SECONDS=30
LLM_REQUEST_TIMEOUT_MS=120000

# 前端 CORS 白名单(逗号分隔)
CORS_ORIGIN=http://localhost:3000
