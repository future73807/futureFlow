# ============================================================
# futureFlow 根目录环境变量
# ============================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=futureflow
POSTGRES_USER=futureflow
POSTGRES_PASSWORD=futureflow123

# Dify 执行层(Service API,app- 前缀的密钥)
DIFY_API_BASE=http://localhost/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx

# Dify 控制台(Console API,用于 DSL 导入更新工作流)
DIFY_CONSOLE_BASE=http://localhost/console/api
DIFY_CONSOLE_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DIFY_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 网关
GATEWAY_PORT=3001
GATEWAY_JWT_SECRET=change-me-in-production
