# ============================================================
# futureFlow 网关环境变量
# 将此文件复制为 .env 并填写实际值
# 网关也会从上级目录 ../.env 读取配置
# ============================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=futureflow
POSTGRES_USER=futureflow
POSTGRES_PASSWORD=futureflow123

# Dify 执行层(Service API)
# 在 Dify 后台创建工作流应用后,获取 app- 前缀的 API Key
DIFY_API_BASE=http://localhost/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx

# Dify 控制台(Console API,用于 DSL 自动导入)
# 在 Dify 账号设置 → API 密钥 中生成 Console Token
# DIFY_APP_ID 从应用 URL 中获取(如 /app/xxx-xxx-xxx)
DIFY_CONSOLE_BASE=http://localhost/console/api
DIFY_CONSOLE_TOKEN=
DIFY_APP_ID=

# 网关端口
GATEWAY_PORT=3001
