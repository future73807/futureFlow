{
  "name": "futureflow",
  "version": "0.1.0",
  "description": "AI 工作流平台 - FlowGram 画布 + 自研网关 + 无头 Dify",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "db:up": "docker compose up -d postgres",
    "compose:up": "docker compose up -d",
    "infra:up": "node scripts/start-full-stack.cjs --infrastructure-only",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "gateway": "pnpm --filter futureflow-gateway start:dev",
    "frontend": "pnpm --filter @flowgram.ai/demo-free-layout start",
    "dev": "pnpm run gateway & pnpm run frontend",
    "dev:concurrent": "concurrently -n GATEWAY,FRONTEND -c blue,green \"pnpm:gateway\" \"pnpm:frontend\"",
    "start": "node scripts/start-full-stack.cjs",
    "env:init": "node scripts/init-env.cjs",
    "quickstart": "pnpm run env:init && pnpm install --prod=false && pnpm run start",
    "build:gateway": "pnpm --filter futureflow-gateway build",
    "build:frontend": "pnpm --filter @flowgram.ai/demo-free-layout build:prod",
    "ts-check": "pnpm -r exec tsc --noEmit",
    "test:archive": "node scripts/test-result-archive.cjs",
    "test:media-credential-ui": "node scripts/test-media-credential-ui.cjs",
    "test:batch-loop-runtime": "node scripts/test-batch-loop-runtime.cjs",
    "test:condition-runtime": "node scripts/test-condition-runtime.cjs",
    "test:http-runtime": "node scripts/test-http-runtime.cjs",
    "test:media-dify-chain": "node scripts/test-media-dify-chain.cjs",
    "test:fresh-volume": "node scripts/fresh-volume-e2e.cjs",
    "test:api": "node scripts/api-test.cjs",
    "test:full-chain": "node scripts/full-chain-test.cjs",
    "test:platform": "pnpm --filter futureflow-gateway test:smoke && pnpm --filter futureflow-gateway test:integration && pnpm --filter futureflow-gateway test:fuzz",
    "verify": "pnpm run ts-check && pnpm run test:archive && pnpm run test:media-credential-ui && pnpm --filter futureflow-gateway test:batch-loop && pnpm run test:batch-loop-runtime && pnpm run test:condition-runtime && pnpm run test:http-runtime && pnpm run test:platform && pnpm run build:gateway && pnpm run build:frontend",
    "test:e2e": "node scripts/e2e-full-test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright-core": "1.62.1"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
