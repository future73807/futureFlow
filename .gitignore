CREDENTIALS.local.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Database
*.sqlite
*.db

# Runtime-generated media assets
.futureflow-media/
# Runtime-generated uploaded files（网关 MEDIA_ASSET_ROOT 同级的上传落盘目录）
gateway/.futureflow-files/

# Docker volumes
dify/volumes/
postgres-data/

# 备份产物（scripts/backup.cjs 生成，含数据库转储，切勿提交）
.futureflow-backups/

# pnpm 安装被中断时留在仓库根目录的临时文件
_tmp_*

# FlowGram demo
demo-free-layout/node_modules/

# GUI click test screenshots (generated by scripts/test-gui-click.cjs)
gui-test-screenshots/

# Editor scratch directory
.zcode-tmp/

# Mimosa security scan artifacts
.mimosa/
.video_agent/
# GUI full-flow test screenshots
gui-full-screenshots/

# Gateway runtime stderr log
gateway-run.log.err

# WorkBuddy AI 工作区数据（记忆、技能等本地状态，不随仓库分发）
.workbuddy-ai/

# AI 工具在本目录留下的本地状态（非项目内容）
.commandcode/

# Python 执行节点运行时生成的字节码缓存（gateway/vendor/python 下）
__pycache__/
*.py[cod]
